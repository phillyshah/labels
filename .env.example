# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- auth (V1: single shared password; swap to Supabase Auth later) ---
APP_PASSWORD=change-me-strong-password
SESSION_SECRET=generate-a-long-random-string
SESSION_TTL_SECONDS=43200

# --- internal processor contract ---
PROCESSOR_SHARED_SECRET=generate-another-random-string

# --- rules ---
RULES_PATH=config/rules.yaml

# --- persistence ---
# Leave DATABASE_URL empty to use the local dev store (no Supabase needed).
# For Supabase, use the pooler URL from the dashboard (matches the user's NailTracker convention):
#   postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=submissions

# --- training: AI-suggested rule edits (optional) ---
# When set, the Training tab's "Suggest improvements" button drafts reviewable rule
# changes from your feedback via the Claude API. Leave empty to disable the feature
# (everything else in Training works without it). ASSIST_MODEL is optional.
ANTHROPIC_API_KEY=
ASSIST_MODEL=claude-sonnet-4-6

# --- misc ---
# Comma-separated allowed origins. In production the SPA is same-origin, so this can stay tight.
CORS_ORIGINS=*
